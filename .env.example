# ── Required in production (Vercel → Settings → Environment Variables) ──
# Neon Postgres connection string (fail-closed: no local SQLite on Vercel).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Long random string used to sign login tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Admin accounts (fail closed: admin login is disabled unless set) ──
# Option A — individual accounts (recommended):
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me
# ADMIN_USERNAME= / ADMIN_PASSWORD=
# REGISTRAR_USERNAME= / REGISTRAR_PASSWORD=
# OFFICER_USERNAME= / OFFICER_PASSWORD=
# Option B — single JSON array instead:
# ADMIN_ACCOUNTS_JSON=[{"username":"superadmin","password":"change-me","name":"Chief Electoral Officer","role":"superadmin"}]

# ── CORS: extra cross-origin frontends allowed to call /api/* ──
# Same-origin needs nothing. Add preview/admin domains here, comma-separated:
# ALLOWED_ORIGINS=https://admin.yourdomain.com

# ── Local dev only (never set on Vercel) ──
# PORT=5005
